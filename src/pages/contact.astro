---
import PageLayout from '../layouts/PageLayout.astro';
import { CONTACT_EMAIL, SOCIALS } from '../data/contact';
// The form sends the message to the team's email through the same Google
// Apps Script web app as the waitlist (contact.ts).
---

<PageLayout title="Contact us" description="Get in touch with the Zend team.">
  <p>
    Have a question about Zend, need help with the waitlist, or want to work with us? Send us a message. A real person reads every one, and we usually reply within 1–2 working days.
  </p>

  <form class="ct" novalidate>
    <label class="ct__field">
      <span class="ct__label">Your name</span>
      <input class="ct__input" name="name" type="text" autocomplete="name" placeholder="e.g. Treasure" maxlength="80" />
    </label>
    <label class="ct__field">
      <span class="ct__label">Your email</span>
      <input class="ct__input" name="email" type="email" inputmode="email" autocomplete="email" placeholder="you@email.com" maxlength="120" />
      <span class="ct__hint">So we can reply to you.</span>
    </label>
    <label class="ct__field">
      <span class="ct__label">Message</span>
      <textarea class="ct__input ct__area" name="message" rows="6" placeholder="How can we help?" maxlength="4000"></textarea>
    </label>
    <!-- Bots fill this; people never see it. -->
    <input class="ct__hp" name="zx_hp_field" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <p class="ct__error" role="alert"></p>
    <button class="btn ct__send" type="submit">
      <span class="ct__send-text">Send message</span>
      <span class="ct__spinner" aria-hidden="true"></span>
    </button>
    <p class="ct__done" role="status" hidden>
      <strong>Thank you! Your message is on its way.</strong> We'll reply to your email within 1–2 working days.
    </p>
  </form>

  <h2>Other ways to reach us</h2>
  <ul>
    <li>Email: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
    <li>Instagram: <a href={SOCIALS.instagram.url} rel="noopener" target="_blank">{SOCIALS.instagram.handle}</a></li>
    <li>X: <a href={SOCIALS.x.url} rel="noopener" target="_blank">{SOCIALS.x.handle}</a></li>
  </ul>

  <h2>Before you write</h2>
  <ul>
    <li><strong>Want to know when Zend is ready?</strong> <a href="/" data-waitlist>Join the waitlist</a> and we'll tell you first.</li>
    <li><strong>Questions about how Zend works?</strong> Our <a href="/#faq">FAQ</a> may already have the answer.</li>
    <li><strong>Want your details removed?</strong> Send us a message from the phone number or email you signed up with, and we'll delete them.</li>
  </ul>
</PageLayout>

<script>
  import { initContactForm } from '../scripts/contact';
  initContactForm();
</script>

<style>
  .ct {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 560px;
    margin: 32px 0 8px;
  }
  .ct__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ct__label {
    font-size: 15px;
    font-weight: 500;
    color: var(--c-hiw-head);
  }
  .ct__hint {
    font-size: 14px;
    opacity: 0.7;
  }
  .ct__input {
    width: 100%;
    box-sizing: border-box;
    min-height: 52px;
    padding: 0 16px;
    border: 1.5px solid var(--c-card-border);
    border-radius: 14px;
    background: var(--c-card-bg);
    color: var(--c-text);
    font: inherit;
    font-size: 16px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global([data-theme='dark']) .ct__input,
  :global([data-theme='dark']) .ct__label {
    color: rgb(255 255 255 / 0.85); /* off-white at night */
  }
  .ct__area {
    padding: 14px 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .ct__input::placeholder {
    color: currentColor;
    opacity: 0.45;
  }
  .ct__input:focus {
    border-color: var(--c-accent);
    box-shadow: 0 0 0 4px rgb(195 143 248 / 0.25);
  }
  .ct__input[aria-invalid='true'] {
    border-color: #e5484d;
  }
  .ct__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ct__error {
    min-height: 1.4em;
    margin: -6px 0 0;
    font-size: 14px;
    color: #e5484d;
  }
  .ct__send {
    align-self: flex-start;
    gap: 10px;
    border: 0;
    font: inherit;
    font-size: 17px;
    height: 52px;
    padding: 0 28px;
    cursor: pointer;
  }
  .ct__spinner {
    display: none;
    width: 18px;
    height: 18px;
    border: 2.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: ct-spin 0.7s linear infinite;
  }
  .ct__send[aria-busy='true'] .ct__spinner {
    display: inline-block;
  }
  @keyframes ct-spin {
    to {
      rotate: 1turn;
    }
  }
  .ct__done {
    margin: 0;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--c-card-bg);
    border: 1.5px solid var(--c-card-border);
  }
  @media (max-aspect-ratio: 5/4) {
    .ct__send {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
