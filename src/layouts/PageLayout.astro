---
// Inner pages (privacy, terms, partners, contact): top bar, heading, the
// page's content, short footer. No intro and no scroll story.
import Base from './Base.astro';
import PageHeader from '../components/page/PageHeader.astro';
import ShortFooter from '../components/page/ShortFooter.astro';
import Waitlist from '../components/Waitlist.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base page="page" title={`${title} · Zend`} description={description}>
  <PageHeader title={title} />
  <main class="pg-main">
    <slot />
  </main>
  <ShortFooter />
  <Waitlist />
</Base>

<script>
  import { initPage } from '../scripts/page';
  initPage();
</script>

<style>
  .pg-main {
    width: min(1525px, calc(100% - 2 * max(20px, 6vw)));
    min-height: 50svh;
    margin: 48px auto 0;
    color: var(--c-text);
    font-size: 17px;
    line-height: 1.7;
  }
  .pg-main :global(h2) {
    margin: 2em 0 0.5em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.3;
    color: var(--c-hiw-head);
  }
  .pg-main :global(p),
  .pg-main :global(li) {
    max-width: 72ch;
  }
  .pg-main :global(a:not(.btn)) {
    color: var(--c-link);
  }
  .pg-main :global(ul) {
    padding-left: 1.2em;
  }
  .pg-main :global(li) {
    margin: 0.3em 0;
  }
  .pg-main :global(.pg-updated) {
    margin: 0 0 1.5em;
    font-size: 15px;
    opacity: 0.7;
  }
  /* Details still to fill in: easy to spot until replaced. */
  .pg-main :global(mark.pg-todo) {
    padding: 0 0.25em;
    border-radius: 4px;
    background: rgb(255 214 0 / 0.35);
    color: inherit;
  }
  /* Night: the write-up is off-white; lilac is only for selected items
     (links stay off-white, underlined, and turn lilac on hover). */
  :global([data-theme='dark']) .pg-main {
    color: var(--c-foot-text);
  }
  :global([data-theme='dark']) .pg-main :global(a:not(.btn)) {
    color: var(--c-foot-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  :global([data-theme='dark']) .pg-main :global(a:not(.btn):hover) {
    color: var(--c-accent);
  }
  .pg-main :global(.pg-soon) {
    color: inherit;
    opacity: 0.7;
  }
  @media (max-aspect-ratio: 5/4) {
    .pg-main {
      margin-top: 32px;
      font-size: 16px;
    }
  }
</style>
